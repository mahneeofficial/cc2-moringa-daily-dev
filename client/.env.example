# =====================================================================
# Moringa Daily — FRONTEND environment variables
# =====================================================================
# Copy this file:   cp .env.example .env
# client/.env is git-ignored — safe for any value.
# =====================================================================

# Where the Flask API is running.
#   Local dev:      http://localhost:5001   (this default — you can
#                   leave this file alone for local work)
#   Production:     your Render backend URL, e.g.
#                   https://moringa-backend-xxxx.onrender.com
VITE_API_BASE_URL=http://localhost:5001
