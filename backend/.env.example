# =====================================================================
# Moringa Daily — BACKEND environment variables
# =====================================================================
# HOW TO USE:
#   1. Copy this file:            cp .env.example .env
#   2. Fill in real values below (especially GEMINI_API_KEY).
#   3. Restart the backend (bash dev.sh from the repo root, or restart flask).
#
# backend/.env is GIT-IGNORED — your keys are never committed to GitHub.
# (config.py loads this file automatically on startup.)
# =====================================================================

FLASK_ENV=development
PORT=5001

# ---------------------------------------------------------------------
# 🤖 AI FEATURES — Summarize with AI, category suggest, enhance writing
# ---------------------------------------------------------------------
# This is where you put your Gemini API key. Without it, every AI button
# returns 500 with a clear "GEMINI_API_KEY is not set yet" message.
#
# Get a FREE key (takes ~1 minute):
#   1. Go to  https://aistudio.google.com/apikey
#   2. Sign in with Google  →  "Create API key"
#   3. Copy the key (starts with "AIza...") and paste it below:
GEMINI_API_KEY=paste_your_gemini_key_here

# ---------------------------------------------------------------------
# 🔑 SECRETS (only needed if you host publicly somewhere that doesn't
# generate them — Render auto-generates both from render.yaml)
# ---------------------------------------------------------------------
# SECRET_KEY=change-me-to-something-random
# JWT_SECRET_KEY=change-me-to-something-random-too

# ---------------------------------------------------------------------
# 🗄️  DATABASE
# ---------------------------------------------------------------------
# Leave DATABASE_URL unset to use the local SQLite file (backend/app.db).
# On Render this is wired automatically from the moringa-db service.
# DATABASE_URL=postgresql://user:password@host:5432/moringa

# ---------------------------------------------------------------------
# ⚙️  BEHAVIOUR FLAGS (optional)
# ---------------------------------------------------------------------
# Force EVERY post — including admins and tech writers — through the
# review queue instead of publishing instantly (useful while testing
# moderation). Leave commented out for normal behaviour.
# MODERATE_ALL_POSTS=1
